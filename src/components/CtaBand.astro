---
import Icon from './Icon.astro';
import { site } from '@/data/site';

interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Want someone to look at your roof?',
  text = 'Call, send a photo on WhatsApp, or request a written quote. We come out, have a proper look, and put the price in writing.',
} = Astro.props;
---

<section class="bg-navy text-white">
  <div class="container-x flex flex-col gap-8 py-14 md:flex-row md:items-center md:justify-between md:py-16">
    <div class="max-w-xl">
      <h2 class="text-h2 text-white">{heading}</h2>
      <p class="mt-3 text-white/80">{text}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href={site.phoneHref} class="btn-primary">
        <Icon name="phone" class="h-5 w-5" />
        {site.phoneDisplay}
      </a>
      <a href={site.whatsappHref} target="_blank" rel="noopener" class="btn-outline-light">
        <Icon name="whatsapp" class="h-5 w-5" />
        WhatsApp
      </a>
      <a href="/contact/" class="btn-outline-light">Request a quote</a>
    </div>
  </div>
</section>
