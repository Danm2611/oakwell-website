---
/**
 * Oakwell mark: a refined redraw of the original logo (two house outlines over a skyline),
 * drawn as flat vector so it works at 32px, in one colour, and over photographs.
 */
interface Props {
  variant?: 'full' | 'mark';
  tone?: 'colour' | 'white' | 'navy';
  class?: string;
}
const { variant = 'full', tone = 'colour', class: className = '' } = Astro.props;

const colours = {
  colour: { house: '#2e6e9e', skyDark: '#1e3a4f', skyLight: '#8fc1e3', word: '#1e3a4f', sub: '#2e6e9e' },
  white: { house: '#ffffff', skyDark: 'rgba(255,255,255,0.55)', skyLight: 'rgba(255,255,255,0.28)', word: '#ffffff', sub: 'rgba(255,255,255,0.8)' },
  navy: { house: '#1e3a4f', skyDark: '#27506c', skyLight: '#8fc1e3', word: '#1e3a4f', sub: '#2e6e9e' },
}[tone];
---

<span class={`inline-flex items-center gap-3 ${className}`}>
  <svg
    viewBox="0 0 400 300"
    class="h-[1em] w-auto shrink-0"
    style="font-size: inherit"
    aria-hidden="true"
    focusable="false"
  >
    <!-- skyline -->
    <polygon points="58,96 92,112 92,246 58,246" fill={colours.skyDark} />
    <polygon points="104,52 128,64 128,246 104,246" fill={colours.skyLight} />
    <polygon points="138,22 200,54 200,246 138,246" fill={colours.skyDark} />
    <polygon points="226,34 272,60 272,246 226,246" fill={colours.skyDark} />
    <polygon points="290,96 326,114 326,246 290,246" fill={colours.skyLight} />
    <!-- house one -->
    <path d="M14 246 L36 246 L150 112 L206 178" fill="none" stroke={colours.house} stroke-width="18" stroke-linejoin="miter" stroke-linecap="butt" />
    <polygon points="170,133 170,166 186,186 186,133" fill={colours.house} />
    <rect x="128" y="186" width="18" height="18" fill={colours.house} />
    <rect x="152" y="186" width="18" height="18" fill={colours.house} />
    <rect x="128" y="210" width="18" height="18" fill={colours.house} />
    <rect x="152" y="210" width="18" height="18" fill={colours.house} />
    <!-- house two -->
    <path d="M190 246 L212 246 L302 140 L386 246 L372 246" fill="none" stroke={colours.house} stroke-width="18" stroke-linejoin="miter" stroke-linecap="butt" />
    <polygon points="334,170 334,205 350,224 350,170" fill={colours.house} />
    <rect x="284" y="196" width="18" height="18" fill={colours.house} />
    <rect x="308" y="196" width="18" height="18" fill={colours.house} />
    <rect x="284" y="220" width="18" height="18" fill={colours.house} />
    <rect x="308" y="220" width="18" height="18" fill={colours.house} />
    <!-- eaves feet -->
    <rect x="0" y="246" width="56" height="16" fill={colours.house} />
    <rect x="344" y="246" width="56" height="16" fill={colours.house} />
    <rect x="176" y="246" width="56" height="16" fill={colours.house} />
  </svg>
  {variant === 'full' && (
    <span class="flex flex-col leading-none">
      <span class="font-display font-extrabold tracking-[-0.01em] text-[0.62em]" style={`color:${colours.word}; font-stretch: 112%`}>OAKWELL</span>
      <span class="mt-[0.18em] font-display text-[0.26em] font-semibold uppercase tracking-[0.22em]" style={`color:${colours.sub}`}>Roofing Contractors</span>
    </span>
  )}
</span>
