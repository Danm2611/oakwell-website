---
import Icon from './Icon.astro';
import { site, fullAddress } from '@/data/site';
---

<div class="grid gap-4">
  <a href={site.phoneHref} class="flex items-center gap-4 rounded-lg bg-navy p-5 text-white">
    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white/10"><Icon name="phone" class="h-6 w-6" /></span>
    <span>
      <span class="block font-display text-2xl font-bold">{site.phoneDisplay}</span>
      <span class="block text-sm text-white/75">Ask for {site.contactName}. {site.emergency}.</span>
    </span>
  </a>
  <a href={site.whatsappHref} target="_blank" rel="noopener" class="flex items-center gap-4 rounded-lg bg-[#1f7a4d] p-5 text-white">
    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white/10"><Icon name="whatsapp" class="h-6 w-6" /></span>
    <span>
      <span class="block font-display text-lg font-bold">Send photos on WhatsApp</span>
      <span class="block text-sm text-white/80">Quickest way to get a first opinion</span>
    </span>
  </a>
  <div class="rounded-lg border border-stone-200 bg-white p-5">
    <div class="flex items-start gap-4">
      <Icon name="mail" class="mt-0.5 h-5 w-5 shrink-0 text-terracotta" />
      <div>
        <div class="font-display font-semibold text-navy">Email</div>
        <a href={`mailto:${site.email}`} class="break-all text-blue underline-offset-2 hover:underline">{site.email}</a>
      </div>
    </div>
    <div class="mt-4 flex items-start gap-4">
      <Icon name="pin" class="mt-0.5 h-5 w-5 shrink-0 text-terracotta" />
      <div>
        <div class="font-display font-semibold text-navy">Based in Morley, Leeds</div>
        <p class="text-[15px] text-ink/75">{fullAddress()}. We cover all of West Yorkshire.</p>
      </div>
    </div>
    <div class="mt-4 flex items-start gap-4">
      <Icon name="clock" class="mt-0.5 h-5 w-5 shrink-0 text-terracotta" />
      <div>
        <div class="font-display font-semibold text-navy">Phone hours</div>
        <dl class="text-[15px] text-ink/75">
          {site.hours.map((h) => (
            <div class="flex gap-3"><dt class="w-44">{h.days}</dt><dd>{h.time}</dd></div>
          ))}
          <div class="flex gap-3"><dt class="w-44">Emergencies</dt><dd>Any time, day or night</dd></div>
        </dl>
      </div>
    </div>
  </div>
</div>
