---
/** Visible FAQ list. FAQPage schema is emitted only here, so the markup always matches what is on the page. */
interface Props {
  items: { q: string; a: string }[];
  heading?: string;
}
const { items, heading = 'Questions people ask' } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

{items.length > 0 && (
  <section class="py-16 md:py-20" aria-labelledby="faq-heading">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow">Good to know</p>
        <h2 id="faq-heading" class="mt-2 text-h2">{heading}</h2>
        <p class="mt-4 text-ink/75">If yours isn't here, call or message and we'll give you a straight answer.</p>
      </div>
      <div class="lg:col-span-8">
        <div class="divide-y divide-stone-200 border-y border-stone-200">
          {items.map((f) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[17px] font-semibold text-navy [&::-webkit-details-marker]:hidden">
                <span>{f.q}</span>
                <span class="mt-1 shrink-0 text-terracotta transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 max-w-[66ch] text-ink/80">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </section>
)}
