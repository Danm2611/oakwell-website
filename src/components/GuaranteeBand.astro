---
import { site } from '@/data/site';
import Icon from './Icon.astro';
---

<section class="bg-white py-16 md:py-20">
  <div class="container-x grid gap-10 lg:grid-cols-12 lg:items-start">
    <div class="lg:col-span-5">
      <p class="eyebrow">Our guarantee</p>
      <h2 class="mt-2 text-h2">Put in writing, every job</h2>
      <p class="mt-4 text-ink/80">
        Every roof we build or repair comes with a workmanship guarantee from Oakwell Roofing Ltd. We put it in writing when the job is finished, so you know exactly what is covered and for how long.
      </p>
      <p class="mt-3 text-[15px] text-stone">{site.guaranteeNote}</p>
      <a href="/guarantee/" class="mt-6 inline-flex items-center gap-2 font-display font-semibold text-terracotta">
        Read what the guarantee covers
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2 lg:col-span-7">
      {site.guarantees.map((g) => (
        <li class="rounded-lg border border-stone-200 bg-paper p-6" data-reveal>
          <div class="font-display text-4xl font-extrabold text-navy" style="font-stretch: 110%">
            {g.years}<span class="text-xl font-semibold text-stone"> {g.years === 1 ? 'year' : 'years'}</span>
          </div>
          <div class="mt-2 font-semibold text-ink">{g.work}</div>
        </li>
      ))}
    </ul>
  </div>
</section>
