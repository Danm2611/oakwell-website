---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { photo } from '@/lib/photos';

interface Props {
  slug: string;
  title: string;
  summary: string;
  image: string;
  imageAlt: string;
  icon: string;
}
const { slug, title, summary, image, imageAlt, icon } = Astro.props;
---

<a href={`/services/${slug}/`} class="group flex flex-col overflow-hidden rounded-lg bg-white shadow-soft ring-1 ring-stone-200/70 transition-shadow hover:shadow-lg" data-reveal>
  <div class="relative aspect-[4/3] overflow-hidden bg-limewash">
    <Image
      src={photo(image)}
      alt={imageAlt}
      widths={[400, 640, 900]}
      sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
    />
    <span class="absolute left-4 top-4 inline-flex h-10 w-10 items-center justify-center rounded-md bg-white/90 text-navy backdrop-blur">
      <Icon name={icon} class="h-5 w-5" />
    </span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-h3">{title}</h3>
    <p class="mt-2 flex-1 text-[15.5px] text-ink/75">{summary}</p>
    <span class="mt-5 inline-flex items-center gap-2 font-display text-sm font-semibold text-terracotta">
      Find out more
      <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</a>
