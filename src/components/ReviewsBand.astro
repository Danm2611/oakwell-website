---
import Icon from './Icon.astro';
import { site } from '@/data/site';
---

<section class="border-y border-stone-200 bg-paper py-14">
  <div class="container-x flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
    <div class="max-w-xl">
      <p class="eyebrow">Reviews</p>
      <h2 class="mt-2 text-h2">Read what customers say on Google</h2>
      <p class="mt-3 text-ink/80">
        Our reviews live on Google, where we can't edit them. Have a read before you get in touch. If we've worked for you, a review helps more than you'd think.
      </p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href={site.googleReviewsUrl} target="_blank" rel="noopener" class="btn-secondary">
        <Icon name="star" class="h-5 w-5 text-blue-300" />
        Google reviews
      </a>
      <a href={site.facebook} target="_blank" rel="noopener" class="btn-outline">Recent jobs on Facebook</a>
    </div>
  </div>
</section>
