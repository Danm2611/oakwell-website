---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
---

<Base title="Thanks, we've got your enquiry | Oakwell Roofing" description="Your enquiry has been sent to Oakwell Roofing." noindex>
  <main id="main" class="flex-1">
    <section class="py-24 md:py-32">
      <div class="container-x max-w-2xl text-center">
        <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-navy-100 text-navy"><Icon name="check" class="h-8 w-8" /></span>
        <h1 class="mt-6 text-h2">Thanks, we've got your enquiry</h1>
        <p class="mt-4 text-lg text-ink/80">
          {site.contactName} will call you back to ask a few questions and arrange a time to look at the roof. If it's urgent, don't wait for the call.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href={site.phoneHref} class="btn-primary"><Icon name="phone" class="h-5 w-5" /> {site.phoneDisplay}</a>
          <a href="/" class="btn-outline">Back to the home page</a>
        </div>
      </div>
    </section>
  </main>
</Base>
