---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import ContactDetails from '@/components/ContactDetails.astro';
import { site } from '@/data/site';
---

<Base
  title="Contact Oakwell Roofing | Free Roofing Quotes in West Yorkshire"
  description="Call 07469 179470, send a photo on WhatsApp, or request a written quote. Oakwell Roofing, Morley, Leeds. Free surveys and written quotes across West Yorkshire. 24/7 for emergencies."
  breadcrumbs={[{ name: 'Contact', href: '/contact/' }]}
>
  <main id="main">
    <PageHero
      eyebrow="Contact"
      title="Get a quote"
      intro={`Call ${site.contactName}, send a photo on WhatsApp, or fill in the form and we'll call you back to arrange a look. Surveys and written quotes are free.`}
      crumbs={[{ name: 'Contact', href: '/contact/' }]}
    />
    <section class="py-14 md:py-20">
      <div class="container-x grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 class="text-h2">Tell us about the roof</h2>
          <p class="mt-3 mb-8 max-w-[56ch] text-ink/80">
            The more you can tell us, the better the first conversation. A photo of the problem helps a lot. If water is coming in right now, ring {site.phoneDisplay} rather than waiting for a reply.
          </p>
          <QuoteForm />
        </div>
        <div class="lg:col-span-5">
          <ContactDetails />
          <div class="mt-5 rounded-lg border border-stone-200 bg-paper p-5 text-[15px] text-ink/75">
            <p class="font-display font-semibold text-navy">What happens next</p>
            <ol class="mt-2 list-decimal space-y-1 pl-5">
              <li>{site.contactName} calls you back to ask a few questions and arrange a visit.</li>
              <li>We look at the roof and tell you what it needs.</li>
              <li>You get a written quote. No obligation.</li>
            </ol>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
